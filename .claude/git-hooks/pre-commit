#!/usr/bin/env bash
# Git pre-commit de projeto/: recusa o commit quando ele leva
#  - documentação (.md e afins, pastas docs/), exceto o README.md da raiz;
#  - arquivo sensível (.env com valores, chaves, certificados, parametro.json);
#  - segredo no conteúdo (padrões de .claude/hooks/padroes-segredos.txt);
#  - código direto na branch principal: ela recebe merge e, direto, só o README.md e a
#    configuração do git.
# Vale para commits do Claude e de qualquer pessoa, por qualquer ferramenta.
# Ligado por: git -C projeto config core.hooksPath ../.claude/git-hooks
# As regras ficam em .claude/hooks/comum.sh, as mesmas do hook de edição do Claude.

KIT_HOOKS="$(cd "$(dirname "$0")/../hooks" && pwd)"
# shellcheck source=../hooks/comum.sh
source "$KIT_HOOKS/comum.sh"

# Aqui o diretório atual é projeto/, então carregar_comandos não acharia o arquivo pelo Root.
# shellcheck disable=SC1090
[ -f "$KIT_HOOKS/../comandos.conf" ] && source <(tr -d '\r' < "$KIT_HOOKS/../comandos.conf")
BRANCH_PRINCIPAL="${BRANCH_PRINCIPAL:-main}"

CODIGO_NA_PRINCIPAL=()
DOCS=()
SENSIVEIS=()
NA_PRINCIPAL=0
# Liberados na principal: o primeiro commit do repositório (ela ainda não existe) e a conclusão
# de um merge que teve conflito (o merge sem conflito nem passa por este hook).
if [ "$(git symbolic-ref --short -q HEAD)" = "$BRANCH_PRINCIPAL" ] \
  && git rev-parse -q --verify HEAD >/dev/null \
  && ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  NA_PRINCIPAL=1
fi

while IFS= read -r -d '' arq; do
  if eh_sensivel "$arq"; then SENSIVEIS+=("$arq"); continue; fi
  if eh_documentacao "$arq"; then
    git ls-files --error-unmatch -- "$arq" >/dev/null 2>&1 && DOCS+=("$arq")
    continue
  fi
  if [ $NA_PRINCIPAL -eq 1 ] && ! eh_doc_do_projeto "$arq"; then CODIGO_NA_PRINCIPAL+=("$arq"); fi
done < <(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD -z)

# Segredos nas linhas adicionadas: "arquivo<TAB>linha", sem mostrar o valor encontrado.
TAB=$'\t'
ADICOES=$(git -c core.quotePath=false diff --cached -U0 --no-color --diff-filter=ACMR | awk '
  /^\+\+\+ / { f = substr($0, 7); next }
  /^\+/      { print f "\t" substr($0, 2) }')
COM_SEGREDO=""
PADROES="$KIT_HOOKS/padroes-segredos.txt"
if [ -n "$ADICOES" ] && [ -f "$PADROES" ]; then
  # Agrupa os padrões pela exceção de caminho: um grep por grupo, não um por padrão.
  EXCECOES=(); EXPRESSOES=()
  while IFS= read -r linha || [ -n "$linha" ]; do
    linha=${linha%$'\r'}
    [[ -z "$linha" || "$linha" == \#* ]] && continue
    PADRAO="${linha%%|||*}"
    EXCECAO=""
    [[ "$linha" == *"|||"* ]] && EXCECAO="${linha#*|||}"
    achou_grupo=0
    for i in "${!EXCECOES[@]}"; do
      if [ "${EXCECOES[$i]}" = "$EXCECAO" ]; then
        EXPRESSOES[$i]="${EXPRESSOES[$i]}|($PADRAO)"; achou_grupo=1; break
      fi
    done
    [ $achou_grupo -eq 1 ] || { EXCECOES+=("$EXCECAO"); EXPRESSOES+=("($PADRAO)"); }
  done < "$PADROES"

  for i in "${!EXCECOES[@]}"; do
    ACHOU=$(printf '%s\n' "$ADICOES" \
      | EXC="${EXCECOES[$i]}" PROJ="$PASTA_PROJETO" awk -F'\t' 'ENVIRON["EXC"] == "" || (ENVIRON["PROJ"] "/" $1) !~ ENVIRON["EXC"]' \
      | grep -E -- "^[^$TAB]*$TAB.*(${EXPRESSOES[$i]})" | cut -f1 | sort -u)
    [ -n "$ACHOU" ] && COM_SEGREDO+="$ACHOU"$'\n'
  done
fi
COM_SEGREDO=$(printf '%s' "$COM_SEGREDO" | sed '/^$/d' | sort -u)

[ ${#CODIGO_NA_PRINCIPAL[@]} -eq 0 ] && [ ${#DOCS[@]} -eq 0 ] && [ ${#SENSIVEIS[@]} -eq 0 ] && [ -z "$COM_SEGREDO" ] && exit 0

{
  echo "Commit recusado pela regra do projeto."
  if [ ${#CODIGO_NA_PRINCIPAL[@]} -gt 0 ]; then
    echo
    echo "$BRANCH_PRINCIPAL só recebe merge e, direto, o README.md e a configuração do git."
    echo "Código vai numa branch de etapa (ciclo-NN-etapa-EE) ou de ciclo curto (curto-NNN):"
    printf '  %s\n' "${CODIGO_NA_PRINCIPAL[@]}"
  fi
  if [ ${#DOCS[@]} -gt 0 ]; then
    echo
    echo "Documentação (mova para ../$PASTA_PRIVADO/docs/; $PASTA_PROJETO/ só leva código):"
    printf '  %s\n' "${DOCS[@]}"
  fi
  if [ ${#SENSIVEIS[@]} -gt 0 ]; then
    echo
    echo "Arquivo sensível (guarde em ../$PASTA_PRIVADO/parametros/):"
    printf '  %s\n' "${SENSIVEIS[@]}"
  fi
  if [ -n "$COM_SEGREDO" ]; then
    echo
    echo "Parece haver segredo no conteúdo (use o padrão parametro.json de .claude/rules/parametros.md):"
    printf '%s\n' "$COM_SEGREDO" | sed 's/^/  /'
  fi
  echo
  echo "Para tirar do commit: git restore --staged <arquivo>"
} >&2
exit 1
