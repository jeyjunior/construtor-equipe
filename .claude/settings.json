{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git -C projeto status *)",
      "Bash(git -C projeto diff *)",
      "Bash(git -C projeto log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(bash .claude/bin/secundaria.sh status)",
      "Bash(bash .claude/bin/secundaria.sh mcp)"
    ],
    "ask": [
      "Edit(/privado/docs/objetivo.md)",
      "Bash(git init*)",
      "Bash(git -C * init*)",
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git remote add*)",
      "Bash(git -C * remote add*)"
    ],
    "deny": [
      "Read(/privado/parametros/**)",
      "Edit(/privado/parametros/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/parametro.json)",
      "Read(**/segredo.json)",
      "Read(**/segredos.json)",
      "Read(**/secrets.json)",
      "Read(/conversor/**/parametros/**)",
      "Read(/conversor/**/sensivel/**)",
      "Edit(/conversor/**)",
      "Read(/conversor/**/*.pem)",
      "Read(/conversor/**/*.pfx)",
      "Read(/conversor/**/*.p12)",
      "Read(/conversor/**/*.key)",
      "Read(/conversor/**/*.jks)",
      "Read(/conversor/**/*.keystore)",
      "Read(/conversor/**/id_rsa*)",
      "Read(/conversor/**/id_ed25519*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar-ambiente.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-comandos.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-estrutura.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-segredos.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/formatar.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar-build.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
